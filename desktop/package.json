{
  "name": "loopfront-desktop",
  "productName": "Loopfront",
  "version": "0.1.0",
  "private": true,
  "description": "Portable offline Windows wrapper for the shared Loopfront game",
  "author": "Loopfront contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node ../node_modules/@playwright/test/cli.js test --config playwright.config.cjs",
    "pack:windows": "electron-builder --config builder.config.cjs --win zip --x64 --publish never",
    "verify:windows": "node verify-package.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  }
}
